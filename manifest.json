{
  "manifest_version": 3,
  "name": "微信文章本地导出器",
  "version": "0.1.0",
  "description": "将当前打开的微信公众号文章导出为自包含 HTML 或 Markdown；内容仅在本机处理。",
  "minimum_chrome_version": "114",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://mmbiz.qpic.cn/*",
    "https://mmbiz.qlogo.cn/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "导出当前微信文章",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  }
}
